<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- iOS Cupertino Pro Native Dark Mode Theme -->
    <style name="Theme.Myvu" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/ios_blue</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">@color/ios_pill_active_bg</item>
        <item name="colorOnPrimaryContainer">@color/ios_blue</item>

        <item name="colorSecondary">@color/ios_indigo</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="colorTertiary">@color/ios_green</item>
        <item name="colorOnTertiary">#FFFFFF</item>

        <item name="android:colorBackground">@color/ios_system_bg</item>
        <item name="colorSurface">@color/ios_card_bg</item>
        <item name="colorOnSurface">@color/ios_label</item>
        <item name="colorOnSurfaceVariant">@color/ios_secondary_label</item>
        <item name="colorOutline">@color/ios_separator</item>
        <item name="colorOutlineVariant">@color/ios_border</item>

        <item name="android:statusBarColor">@color/ios_system_bg</item>
        <item name="android:navigationBarColor">@color/ios_system_bg</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
    </style>

    <style name="Card.Myvu" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="contentPadding">16dp</item>
        <item name="cardBackgroundColor">@color/ios_card_bg</item>
        <item name="strokeColor">@color/ios_border</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:layout_marginBottom">12dp</item>
    </style>
</resources>
