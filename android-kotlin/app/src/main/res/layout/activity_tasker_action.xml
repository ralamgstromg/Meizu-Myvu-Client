<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/obsidian_bg"
    android:fitsSystemWindows="true">

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnActionBack"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/cyber_teal"
            app:cornerRadius="16dp"
            android:text="‹ Cancelar" />

        <TextView
            style="@style/CardTitle.Myvu"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="18sp"
            android:text="Acción MYVU" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnActionSave"
            style="@style/Button.Myvu"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:textSize="13sp"
            android:text="Guardar" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="16dp"
        android:paddingBottom="24dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Card: Selector de Tipo de Acción -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Card.Myvu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/CardTitle.Myvu"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tipo de Acción" />

                    <TextView
                        style="@style/Label.Myvu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Selecciona el comando a ejecutar en las gafas cuando Tasker dispare esta tarea." />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layActionType"
                        style="@style/Input.Myvu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:clickable="true"
                        android:focusable="false"
                        app:endIconMode="custom"
                        app:endIconDrawable="@android:drawable/arrow_down_float"
                        app:endIconTint="@color/cyber_teal"
                        android:hint="Acción">

                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/actvActionType"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none"
                            android:focusable="false"
                            android:clickable="true"
                            android:cursorVisible="false"
                            android:textColor="@color/on_surface_obsidian"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card: Parámetros de la Acción -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardActionParams"
                style="@style/Card.Myvu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/lblActionParamsTitle"
                        style="@style/CardTitle.Myvu"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Configuración" />

                    <!-- Panel 1: HUD / Notificación -->
                    <LinearLayout
                        android:id="@+id/panelHud"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="8dp">

                        <TextView
                            style="@style/Label.Myvu"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Muestra una notificación emergente en la pantalla HUD de las gafas. Admite variables de Tasker (ej. %asunto, %mensaje)." />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/layHudTitle"
                            style="@style/Input.Myvu"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:hint="Título (Opcional)">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/txtHudTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="text"
                                android:textColor="@color/on_surface_obsidian"
                                android:maxLines="1" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/layHudContent"
                            style="@style/Input.Myvu"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:hint="Mensaje / Contenido">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/txtHudContent"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textMultiLine"
                                android:textColor="@color/on_surface_obsidian"
                                android:minLines="2"
                                android:maxLines="4" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <!-- Panel 2: Teleprompter -->
                    <LinearLayout
                        android:id="@+id/panelTeleprompter"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="8dp"
                        android:visibility="gone">

                        <TextView
                            style="@style/Label.Myvu"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Abre la aplicación de teleprompter en las gafas con el texto indicado." />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/layPrompterTitle"
                            style="@style/Input.Myvu"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:hint="Título del discurso (Opcional)">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/txtPrompterTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="text"
                                android:textColor="@color/on_surface_obsidian"
                                android:maxLines="1" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/layPrompterContent"
                            style="@style/Input.Myvu"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:hint="Texto para el Teleprompter">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/txtPrompterContent"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textMultiLine"
                                android:textColor="@color/on_surface_obsidian"
                                android:minLines="3"
                                android:maxLines="6" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <!-- Panel 3: Brillo -->
                    <LinearLayout
                        android:id="@+id/panelBrightness"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="8dp"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/lblBrightnessValue"
                            style="@style/Label.Myvu"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/cyber_teal"
                            android:text="Nivel de Brillo: 3 (Rango 1 a 5)" />

                        <com.google.android.material.slider.Slider
                            android:id="@+id/sliderBrightness"
                            style="@style/Slider.Myvu"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:valueFrom="1.0"
                            android:valueTo="5.0"
                            android:stepSize="1.0"
                            android:value="3.0" />
                    </LinearLayout>

                    <!-- Panel 4: Volumen -->
                    <LinearLayout
                        android:id="@+id/panelVolume"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="8dp"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/lblVolumeValue"
                            style="@style/Label.Myvu"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/cyber_teal"
                            android:text="Nivel de Volumen: 11 (Rango 0 a 15)" />

                        <com.google.android.material.slider.Slider
                            android:id="@+id/sliderVolume"
                            style="@style/Slider.Myvu"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:valueFrom="0.0"
                            android:valueTo="15.0"
                            android:stepSize="1.0"
                            android:value="11.0" />
                    </LinearLayout>

                    <!-- Panel 5: Ajustes de Sistema (WiFi, Zen, Air, Posición FOV) -->
                    <LinearLayout
                        android:id="@+id/panelSystem"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="8dp"
                        android:visibility="gone">

                        <LinearLayout
                            android:id="@+id/subpanelWifi"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                style="@style/Label.Myvu"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:textColor="@color/on_surface_obsidian"
                                android:text="Activar WiFi en las gafas" />

                            <com.google.android.material.materialswitch.MaterialSwitch
                                android:id="@+id/swWifi"
                                style="@style/Switch.Myvu"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/subpanelZenMode"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:layout_marginTop="8dp">

                            <TextView
                                style="@style/Label.Myvu"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:textColor="@color/on_surface_obsidian"
                                android:text="Modo Zen (Silenciar avisos)" />

                            <com.google.android.material.materialswitch.MaterialSwitch
                                android:id="@+id/swZenMode"
                                style="@style/Switch.Myvu"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/subpanelAirMode"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:layout_marginTop="8dp">

                            <TextView
                                style="@style/Label.Myvu"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:textColor="@color/on_surface_obsidian"
                                android:text="Modo Air" />

                            <com.google.android.material.materialswitch.MaterialSwitch
                                android:id="@+id/swAirMode"
                                style="@style/Switch.Myvu"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/subpanelStandbyPos"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginTop="12dp">

                            <TextView
                                android:id="@+id/lblStandbyPosValue"
                                style="@style/Label.Myvu"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="@color/cyber_teal"
                                android:text="Posición Standby FOV: 0 (Centro)" />

                            <com.google.android.material.slider.Slider
                                android:id="@+id/sliderStandbyPos"
                                style="@style/Slider.Myvu"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:valueFrom="0.0"
                                android:valueTo="3.0"
                                android:stepSize="1.0"
                                android:value="0.0" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Panel 6: Raw JSON -->
                    <LinearLayout
                        android:id="@+id/panelRaw"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="8dp"
                        android:visibility="gone">

                        <TextView
                            style="@style/Label.Myvu"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Envía una carga útil JSON sin procesar directamente a la capa de aplicaciones de las gafas. Admite variables de Tasker." />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/layRawJson"
                            style="@style/Input.Myvu"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:hint="Comando JSON Raw">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/txtRawJson"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="monospace"
                                android:inputType="textMultiLine"
                                android:textColor="@color/on_surface_obsidian"
                                android:minLines="3"
                                android:maxLines="6" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card: Vista previa del Blurb / Resumen -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Card.Myvu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/CardTitle.Myvu"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Resumen para Tasker" />

                    <TextView
                        android:id="@+id/txtBlurbPreview"
                        style="@style/Label.Myvu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="@color/cyber_teal"
                        android:text="HUD: (sin mensaje)" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
