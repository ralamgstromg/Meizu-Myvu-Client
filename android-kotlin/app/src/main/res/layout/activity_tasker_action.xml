<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/obsidian_bg"
    android:fitsSystemWindows="true">

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnActionBack"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/cyber_teal"
            app:cornerRadius="16dp"
            android:text="‹ Cancelar" />

        <TextView
            style="@style/CardTitle.Myvu"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="18sp"
            android:text="Mensaje HUD (Gafas)" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnActionSave"
            style="@style/Button.Myvu"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:textSize="13sp"
            android:text="Guardar" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="16dp"
        android:paddingBottom="24dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Card: Configuración del Mensaje HUD -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Card.Myvu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/CardTitle.Myvu"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Notificación / Mensaje HUD" />

                    <TextView
                        style="@style/Label.Myvu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Proyecta un mensaje en la lente de las gafas MYVU. Admite variables de Tasker como %TIME, %BATT, %caller, %msg." />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layHudTitle"
                        style="@style/Input.Myvu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:hint="Título (Opcional)">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/txtHudTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:textColor="@color/on_surface_obsidian"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layHudContent"
                        style="@style/Input.Myvu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:hint="Mensaje / Contenido (Obligatorio)">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/txtHudContent"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textMultiLine"
                            android:textColor="@color/on_surface_obsidian"
                            android:minLines="3"
                            android:maxLines="6" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card: Vista previa del Blurb / Resumen -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Card.Myvu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/CardTitle.Myvu"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Resumen para Tasker" />

                    <TextView
                        android:id="@+id/txtBlurbPreview"
                        style="@style/Label.Myvu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="@color/cyber_teal"
                        android:text="HUD: (sin mensaje)" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
