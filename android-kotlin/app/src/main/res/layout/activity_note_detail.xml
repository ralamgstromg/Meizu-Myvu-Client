<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootNoteDetail"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/obsidian_bg"
    android:orientation="vertical">

    <!-- Top App Bar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarNoteDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/obsidian_bg"
        app:navigationIcon="@drawable/ic_arrow_back_cyber"
        app:title="Detalle de Nota"
        app:titleTextColor="@color/on_surface_obsidian"
        app:titleTextAppearance="@style/TextAppearance.Material3.TitleMedium"
        app:subtitleTextColor="@color/on_surface_variant_obsidian">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingEnd="4dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEditNoteTitle"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:contentDescription="Editar Título"
                app:icon="@drawable/ic_edit"
                app:iconTint="@color/on_surface_obsidian" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReAnalyzeNoteAi"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:contentDescription="Analizar con IA"
                app:icon="@drawable/ic_sparkle"
                app:iconTint="@color/cyber_teal" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSendNoteToGlasses"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:contentDescription="Enviar a Gafas"
                app:icon="@drawable/ic_glasses"
                app:iconTint="@color/cyber_teal" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnShareNote"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:contentDescription="Compartir"
                app:icon="@drawable/ic_share_cyber" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDeleteNote"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:contentDescription="Eliminar"
                app:icon="@drawable/ic_delete_cyber" />
        </LinearLayout>
    </com.google.android.material.appbar.MaterialToolbar>

    <!-- Header Card (Title, Date, Tags) -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="8dp"
        app:cardBackgroundColor="@color/obsidian_container_low"
        app:cardCornerRadius="16dp"
        app:strokeColor="@color/outline_variant_obsidian"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvNoteDetailTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Título de la Nota"
                    android:textColor="@color/on_surface_obsidian"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvNoteDetailDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="15 Ago, 18:30"
                    android:textColor="@color/outline_obsidian"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Tags Row with Edit Button -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvNoteTags"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🏷️ #proyecto #ideas"
                    android:textColor="@color/cyber_teal_dim"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEditNoteTags"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:backgroundTint="@color/obsidian_container_high"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingHorizontal="8dp"
                    android:text="🏷️ Tags"
                    android:textColor="@color/cyber_teal"
                    android:textSize="11sp"
                    app:cornerRadius="6dp" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Tab Navigation -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayoutNoteDetail"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="@color/obsidian_bg"
        app:tabGravity="fill"
        app:tabIndicatorColor="@color/cyber_teal"
        app:tabIndicatorHeight="3dp"
        app:tabMode="fixed"
        app:tabRippleColor="#2200F0FF"
        app:tabSelectedTextColor="@color/cyber_teal"
        app:tabTextColor="@color/on_surface_variant_obsidian">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Contenido" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Resumen IA" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tareas" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mapa Mental" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Chat IA" />
    </com.google.android.material.tabs.TabLayout>

    <!-- AI Processing Status Banner -->
    <LinearLayout
        android:id="@+id/layNoteProcessingBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/obsidian_container_high"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:indeterminateTint="@color/cyber_teal" />

        <TextView
            android:id="@+id/tvNoteProcessingStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Analizando contenido con IA..."
            android:textColor="@color/cyber_teal"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Tabs Content Container -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp">

        <!-- 1. Contenido Tab View -->
        <ScrollView
            android:id="@+id/viewTabNoteContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnNoteTakePhoto"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:backgroundTint="@color/obsidian_container_high"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="📷 Foto"
                        android:textColor="@color/cyber_teal"
                        android:textSize="12sp"
                        app:cornerRadius="8dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnNoteAttachFile"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginStart="8dp"
                        android:backgroundTint="@color/obsidian_container_high"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="📎 Adjuntar Doc"
                        android:textColor="@color/cyber_teal"
                        android:textSize="12sp"
                        app:cornerRadius="8dp" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnEditNoteBody"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:backgroundTint="@color/obsidian_container_high"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="✏️ Editar Texto"
                        android:textColor="@color/cyber_teal"
                        android:textSize="12sp"
                        app:cornerRadius="8dp" />
                </LinearLayout>

                <!-- Attachments List Container -->
                <LinearLayout
                    android:id="@+id/layNoteAttachmentsSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvNoteAttachmentsHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="📎 Archivos y Fotos Adjuntas (0):"
                        android:textColor="@color/cyber_teal"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/layNoteAttachmentsList"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal" />
                    </HorizontalScrollView>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvNoteBodyContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:lineSpacingMultiplier="1.35"
                    android:text="Contenido de la nota..."
                    android:textColor="@color/on_surface_obsidian"
                    android:textIsSelectable="true"
                    android:textSize="15sp" />
            </LinearLayout>
        </ScrollView>

        <!-- 2. Resumen IA Tab View -->
        <ScrollView
            android:id="@+id/viewTabNoteSummary"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvNoteSummaryContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingMultiplier="1.4"
                android:text="Resumen ejecutivo..."
                android:textColor="@color/on_surface_obsidian"
                android:textIsSelectable="true"
                android:textSize="15sp" />
        </ScrollView>

        <!-- 3. Tareas Tab View (CRUD) -->
        <LinearLayout
            android:id="@+id/viewTabNoteTasks"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddNoteManualTask"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:backgroundTint="@color/obsidian_container_high"
                    android:text="+ Nueva Tarea"
                    android:textColor="@color/cyber_teal"
                    android:textStyle="bold"
                    app:cornerRadius="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnExportNoteTasksToTodo"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:backgroundTint="@color/cyber_teal"
                    android:text="Exportar a To-Dos"
                    android:textColor="@color/on_cyber_teal"
                    android:textStyle="bold"
                    app:cornerRadius="12dp" />
            </LinearLayout>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <LinearLayout
                    android:id="@+id/layNoteTasksContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>
        </LinearLayout>

        <!-- 4. Mapa Mental Tab View -->
        <FrameLayout
            android:id="@+id/viewTabNoteMindmap"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <android.webkit.WebView
                android:id="@+id/wvNoteInteractiveMindMap"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/obsidian_bg" />

            <ScrollView
                android:id="@+id/scrollNoteMindmapText"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvNoteMindmapContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:padding="16dp"
                    android:text="mindmap..."
                    android:textColor="@color/cyber_teal_light"
                    android:textSize="14sp" />
            </ScrollView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToggleNoteMindMapView"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_gravity="top|end"
                android:layout_margin="8dp"
                android:backgroundTint="@color/obsidian_container_high"
                android:text="📝 Esquema"
                android:textColor="@color/cyber_teal"
                android:textSize="11sp"
                app:cornerRadius="8dp" />
        </FrameLayout>

        <!-- 5. Chat IA Tab View -->
        <LinearLayout
            android:id="@+id/viewTabNoteQa"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Quick Suggestions -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipNoteQuickExpand"
                        style="@style/Widget.Material3.Chip.Assist"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:text="💡 Desarrollar esta idea"
                        android:textColor="@color/on_surface_obsidian"
                        app:chipBackgroundColor="@color/obsidian_container_high"
                        app:chipStrokeColor="@color/outline_variant_obsidian" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipNoteQuickSummary"
                        style="@style/Widget.Material3.Chip.Assist"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:text="📝 Resumen en 3 puntos"
                        android:textColor="@color/on_surface_obsidian"
                        app:chipBackgroundColor="@color/obsidian_container_high"
                        app:chipStrokeColor="@color/outline_variant_obsidian" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipNoteQuickNextSteps"
                        style="@style/Widget.Material3.Chip.Assist"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚡ Próximos pasos a seguir"
                        android:textColor="@color/on_surface_obsidian"
                        app:chipBackgroundColor="@color/obsidian_container_high"
                        app:chipStrokeColor="@color/outline_variant_obsidian" />
                </LinearLayout>
            </HorizontalScrollView>

            <ScrollView
                android:id="@+id/scrollNoteQaChat"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <LinearLayout
                    android:id="@+id/layNoteQaChatMessages"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_obsidian_card"
                        android:padding="12dp"
                        android:text="✨ Hazme cualquier consulta sobre esta nota o recordatorio para profundizar, estructurar ideas o generar planes de acción."
                        android:textColor="@color/on_surface_variant_obsidian"
                        android:textSize="13sp" />
                </LinearLayout>
            </ScrollView>

            <!-- Question Input Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etNoteQaQuestion"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_obsidian_card"
                    android:hint="Pregunta sobre esta nota..."
                    android:imeOptions="actionSend"
                    android:inputType="textCapSentences"
                    android:paddingHorizontal="14dp"
                    android:textColor="@color/on_surface_obsidian"
                    android:textColorHint="@color/outline_obsidian"
                    android:textSize="14sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSendNoteQaQuestion"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:backgroundTint="@color/cyber_teal"
                    android:contentDescription="Enviar"
                    app:icon="@android:drawable/ic_menu_send"
                    app:iconTint="@color/on_cyber_teal" />
            </LinearLayout>
        </LinearLayout>

    </FrameLayout>

</LinearLayout>
