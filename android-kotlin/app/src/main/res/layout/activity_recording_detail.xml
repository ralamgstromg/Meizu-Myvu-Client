<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/obsidian_bg"
    android:orientation="vertical">

    <!-- Top App Bar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/obsidian_bg"
        app:navigationIcon="@android:drawable/ic_menu_revert"
        app:navigationIconTint="@color/cyber_teal"
        app:title="Detalle de Grabación"
        app:titleTextColor="@color/on_surface_obsidian"
        app:subtitleTextColor="@color/on_surface_variant_obsidian">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:orientation="horizontal"
            android:paddingEnd="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReAnalyzeAi"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:contentDescription="Re-analizar con IA"
                app:icon="@drawable/ic_sparkle"
                app:iconTint="@color/cyber_teal" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSendToGlasses"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:contentDescription="Enviar a Gafas"
                app:icon="@drawable/ic_glasses"
                app:iconTint="@color/cyber_teal" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnShareRecording"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:contentDescription="Compartir"
                app:icon="@android:drawable/ic_menu_share"
                app:iconTint="@color/on_surface_obsidian" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDeleteRecording"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:contentDescription="Eliminar"
                app:icon="@android:drawable/ic_menu_delete"
                app:iconTint="@color/outline_obsidian" />
        </LinearLayout>
    </com.google.android.material.appbar.MaterialToolbar>

    <!-- Player Bar Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="8dp"
        app:cardBackgroundColor="@color/obsidian_container_low"
        app:cardCornerRadius="16dp"
        app:strokeColor="@color/outline_variant_obsidian"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- Scrubber SeekBar + Time Labels -->
            <SeekBar
                android:id="@+id/playerSeekBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:progressTint="@color/cyber_teal"
                android:thumbTint="@color/cyber_teal" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp">

                <TextView
                    android:id="@+id/tvCurrentTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00"
                    android:textColor="@color/outline_obsidian"
                    android:textSize="11sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tvTotalDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00"
                    android:textColor="@color/outline_obsidian"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Player Controls -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <!-- Rewind 5s -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRewind5s"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:contentDescription="Retroceder 5s"
                    app:icon="@android:drawable/ic_media_rew"
                    app:iconTint="@color/on_surface_obsidian" />

                <!-- Main Play / Pause -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMainPlayPause"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_marginHorizontal="16dp"
                    android:backgroundTint="@color/obsidian_container_high"
                    android:contentDescription="Play/Pause"
                    app:icon="@drawable/ic_play_arrow"
                    app:iconSize="28dp"
                    app:iconTint="@color/cyber_teal" />

                <!-- Forward 5s -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnForward5s"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:contentDescription="Adelantar 5s"
                    app:icon="@android:drawable/ic_media_ff"
                    app:iconTint="@color/on_surface_obsidian" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <!-- Speed Toggle -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSpeedToggle"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:backgroundTint="@color/obsidian_container_high"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingHorizontal="8dp"
                    android:text="1.0x"
                    android:textColor="@color/cyber_teal"
                    android:textSize="11sp"
                    app:cornerRadius="16dp" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Tabs Header -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabsDetail"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:background="@color/obsidian_bg"
        app:tabIndicatorColor="@color/cyber_teal"
        app:tabMode="scrollable"
        app:tabSelectedTextColor="@color/cyber_teal"
        app:tabTextColor="@color/on_surface_variant_obsidian">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Transcripción" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Resumen IA" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tareas" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mapa Mental" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Chat IA" />
    </com.google.android.material.tabs.TabLayout>

    <!-- AI Processing Status Banner -->
    <LinearLayout
        android:id="@+id/layProcessingBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/obsidian_container_high"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:indeterminateTint="@color/cyber_teal" />

        <TextView
            android:id="@+id/tvProcessingStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Analizando audio con IA..."
            android:textColor="@color/cyber_teal"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Tabs Content Container -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp">

        <!-- 1. Transcripción Tab View -->
        <ScrollView
            android:id="@+id/viewTabTranscript"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible">

            <LinearLayout
                android:id="@+id/layDiarizedContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvRawTranscript"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingMultiplier="1.3"
                    android:text="Texto de la transcripción..."
                    android:textColor="@color/on_surface_obsidian"
                    android:textIsSelectable="true"
                    android:textSize="15sp" />
            </LinearLayout>
        </ScrollView>

        <!-- 2. Resumen Tab View -->
        <ScrollView
            android:id="@+id/viewTabSummary"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvSummaryContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingMultiplier="1.4"
                android:text="Resumen ejecutivo..."
                android:textColor="@color/on_surface_obsidian"
                android:textIsSelectable="true"
                android:textSize="15sp" />
        </ScrollView>

        <!-- 3. Tareas Tab View -->
        <LinearLayout
            android:id="@+id/viewTabTasks"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnExportAllTasksToTodo"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:backgroundTint="@color/cyber_teal"
                android:text="Exportar todas a Mis Tareas"
                android:textColor="@color/on_cyber_teal"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_add"
                app:iconTint="@color/on_cyber_teal" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvMeetingTasks"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </LinearLayout>

        <!-- 4. Mapa Mental Tab View -->
        <ScrollView
            android:id="@+id/viewTabMindmap"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/obsidian_container_lowest"
                app:cardCornerRadius="16dp"
                app:strokeColor="@color/outline_variant_obsidian"
                app:strokeWidth="1dp">

                <TextView
                    android:id="@+id/tvMindmapContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:lineSpacingMultiplier="1.3"
                    android:padding="16dp"
                    android:text="mindmap..."
                    android:textColor="@color/cyber_teal_light"
                    android:textIsSelectable="true"
                    android:textSize="14sp" />
            </com.google.android.material.card.MaterialCardView>
        </ScrollView>

        <!-- 5. Chat IA Tab View -->
        <LinearLayout
            android:id="@+id/viewTabQa"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <ScrollView
                android:id="@+id/scrollQaChat"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <LinearLayout
                    android:id="@+id/layQaChatMessages"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_obsidian_card"
                        android:padding="12dp"
                        android:text="✨ Hazme cualquier pregunta sobre esta reunión o grabación. Por ejemplo: '¿Cuáles fueron los compromisos de entrega?' o '¿Qué se acordó sobre el presupuesto?'"
                        android:textColor="@color/on_surface_variant_obsidian"
                        android:textSize="13sp" />
                </LinearLayout>
            </ScrollView>

            <!-- Question Input Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etQaQuestion"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_obsidian_card"
                    android:hint="Pregunta sobre la grabación..."
                    android:imeOptions="actionSend"
                    android:inputType="textCapSentences"
                    android:paddingHorizontal="14dp"
                    android:textColor="@color/on_surface_obsidian"
                    android:textColorHint="@color/outline_obsidian"
                    android:textSize="14sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSendQaQuestion"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:backgroundTint="@color/cyber_teal"
                    android:contentDescription="Enviar"
                    app:icon="@android:drawable/ic_menu_send"
                    app:iconTint="@color/on_cyber_teal" />
            </LinearLayout>
        </LinearLayout>

    </FrameLayout>

</LinearLayout>
