<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/obsidian_container"
    app:cardCornerRadius="28dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/outline_variant_obsidian"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/lblNoteCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_chip_badge"
                android:fontFamily="monospace"
                android:letterSpacing="0.05"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="TEXTO"
                android:textColor="@color/cyber_teal"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/lblNoteTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/on_surface_obsidian"
                android:textSize="16sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/lblNoteBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/on_surface_obsidian"
                android:textSize="15sp"
                android:lineSpacingExtra="2dp" />

            <TextView
                android:id="@+id/lblNoteDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="monospace"
                android:textColor="@color/on_surface_variant_obsidian"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnPlayAudio"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Play Audio"
            android:src="@android:drawable/ic_media_play"
            android:visibility="gone"
            app:tint="@color/cyber_teal" />

        <ImageButton
            android:id="@+id/btnEditNote"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Edit Note"
            android:src="@android:drawable/ic_menu_edit"
            app:tint="@color/cyber_teal" />

        <ImageButton
            android:id="@+id/btnDeleteNote"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Delete Note"
            android:src="@android:drawable/ic_menu_delete"
            app:tint="#FF5252" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
