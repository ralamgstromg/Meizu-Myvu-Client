<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardLogItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="3dp"
    app:cardBackgroundColor="@color/ios_card_bg"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/ios_separator"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Header: Level Icon + Source Badge + Level Badge + Timestamp -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Visual Alert Icon (Error / Warning) -->
            <ImageView
                android:id="@+id/imgLevelIcon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="6dp"
                android:src="@drawable/ic_ios_error"
                android:visibility="gone"
                tools:visibility="visible" />

            <!-- Source Badge -->
            <LinearLayout
                android:id="@+id/badgeSource"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_ios_badge_app"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp">

                <ImageView
                    android:id="@+id/imgSourceIcon"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/ic_glasses"
                    app:tint="@color/ios_blue"
                    android:contentDescription="Dispositivo" />

                <TextView
                    android:id="@+id/txtSourceName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="Gafas MYVU"
                    android:textColor="@color/ios_blue"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Level Badge -->
            <TextView
                android:id="@+id/txtLogLevel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_ios_badge_info"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="INFO"
                android:textColor="@color/ios_blue"
                android:textSize="10sp"
                android:textStyle="bold" />

            <!-- Spacer -->
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Timestamp -->
            <TextView
                android:id="@+id/txtTimestamp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="20:45:12.345"
                android:textColor="@color/ios_secondary_label"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Main Log Message -->
        <TextView
            android:id="@+id/txtLogMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="monospace"
            android:lineSpacingExtra="2dp"
            android:text="Connection established with MYVU AR glasses"
            android:textColor="@color/ios_label"
            android:textSize="12sp" />

        <!-- Collapsible Error / Exception Detail Container -->
        <LinearLayout
            android:id="@+id/layoutErrorDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/btnToggleDetails"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mostrar detalles del error ⌄"
                android:textColor="@color/ios_red"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtErrorDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_ios_card_secondary"
                android:fontFamily="monospace"
                android:padding="8dp"
                android:text="Exception detail..."
                android:textColor="@color/ios_red"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
