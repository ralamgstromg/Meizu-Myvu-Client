<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/obsidian_bg"
    android:fitsSystemWindows="true">

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEventBack"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/cyber_teal"
            app:cornerRadius="16dp"
            android:text="‹ Cancelar" />

        <TextView
            style="@style/CardTitle.Myvu"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="18sp"
            android:text="Evento MYVU" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEventSave"
            style="@style/Button.Myvu"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:textSize="13sp"
            android:text="Guardar" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="16dp"
        android:paddingBottom="24dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Card: Selector de Tipo de Evento -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Card.Myvu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/CardTitle.Myvu"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Disparador / Evento" />

                    <TextView
                        style="@style/Label.Myvu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Selecciona el evento en las gafas que activará este perfil en Tasker." />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layEventType"
                        style="@style/Input.Myvu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="Evento">

                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/actvEventType"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none"
                            android:textColor="@color/on_surface_obsidian"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card: Filtro de Gesto Táctil -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/panelGesture"
                style="@style/Card.Myvu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/CardTitle.Myvu"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Filtro de Gesto" />

                    <TextView
                        style="@style/Label.Myvu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Puedes filtrar por un gesto táctil específico o aceptar cualquier gesto." />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layGestureType"
                        style="@style/Input.Myvu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="Gesto">

                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/actvGestureType"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none"
                            android:textColor="@color/on_surface_obsidian"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card: Filtro de Batería -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/panelBattery"
                style="@style/Card.Myvu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/CardTitle.Myvu"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Filtro de Batería" />

                    <TextView
                        style="@style/Label.Myvu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Configura condiciones opcionales para el estado de la batería de las gafas." />

                    <!-- Solo cargando -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/CardTitle.Myvu"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="14sp"
                                android:text="Solo mientras carga" />

                            <TextView
                                style="@style/Label.Myvu"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="12sp"
                                android:text="Disparar únicamente si las gafas están en el cargador." />
                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/swChargingOnly"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <!-- Filtrar nivel específico -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/CardTitle.Myvu"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="14sp"
                                android:text="Filtrar por nivel específico" />

                            <TextView
                                style="@style/Label.Myvu"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="12sp"
                                android:text="Activar solo cuando la batería coincide con el porcentaje exacto o umbral." />
                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/swFilterBattery"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <!-- Slider de Nivel -->
                    <LinearLayout
                        android:id="@+id/subpanelBatterySlider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/lblBatteryLevelValue"
                            style="@style/Label.Myvu"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/on_surface_obsidian"
                            android:text="Nivel: 20%" />

                        <com.google.android.material.slider.Slider
                            android:id="@+id/sliderBatteryLevel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:valueFrom="0"
                            android:valueTo="100"
                            android:stepSize="5"
                            android:value="20"
                            app:thumbColor="@color/cyber_teal"
                            app:trackColorActive="@color/cyber_teal"
                            app:trackColorInactive="@color/outline_variant_obsidian" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card: Variables de Tasker Disponibles -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Card.Myvu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/CardTitle.Myvu"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Variables Exportadas a Tasker" />

                    <TextView
                        style="@style/Label.Myvu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Cuando este evento ocurra, Tasker recibirá automáticamente las siguientes variables locales:" />

                    <TextView
                        style="@style/Label.Myvu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:textColor="@color/cyber_teal"
                        android:text="• %myvu_event: Tipo de evento (touch_gesture, battery_changed, etc.)\n• %myvu_gesture: Nombre del gesto realizado\n• %myvu_battery: Nivel de batería actual (0-100)\n• %myvu_state: Estado de conexión de las gafas" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card: Preview Blurb -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Card.Myvu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/CardTitle.Myvu"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Resumen para Tasker" />

                    <TextView
                        android:id="@+id/txtBlurbPreview"
                        style="@style/Label.Myvu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textStyle="italic"
                        android:textColor="@color/cyber_teal_light"
                        android:text="Gesto Táctil: Cualquier Gesto" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
