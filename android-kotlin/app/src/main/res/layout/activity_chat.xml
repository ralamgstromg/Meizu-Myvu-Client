<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/obsidian_bg"
    android:fitsSystemWindows="false"
    android:paddingHorizontal="12dp">

    <!-- ===== Top Header Bar (topBar for EdgeToEdgeHelper) ===== -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="12dp"
        android:paddingBottom="8dp">

        <ImageButton
            android:id="@+id/btnBackChat"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back_cyber"
            app:tint="@color/on_surface_obsidian"
            android:contentDescription="Regresar" />

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/ic_glasses"
            app:tint="@color/cyber_teal"
            android:contentDescription="Chat IA" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Aura • Chat IA &amp; Skills"
                android:textColor="@color/on_surface_obsidian"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Asistente Virtual • Colombia (es-CO)"
                android:textColor="@color/on_surface_variant_obsidian"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnChatSettings"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_settings"
            app:tint="@color/cyber_teal"
            android:contentDescription="Perfil y Ajustes" />
    </LinearLayout>

    <!-- ===== Chat History List ===== -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvChatHistory"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingVertical="4dp" />

    <!-- Progress Indicator for processing -->
    <ProgressBar
        android:id="@+id/progressChat"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="gone" />

    <!-- ===== Attached Media Preview ===== -->
    <LinearLayout
        android:id="@+id/layImagePreview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp"
        android:background="@color/obsidian_container_low"
        android:visibility="gone">

        <ImageView
            android:id="@+id/imgAttachedPreview"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:scaleType="centerCrop"
            android:contentDescription="Imagen adjunta" />

        <TextView
            android:id="@+id/txtImageAttachedLabel"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Imagen adjunta para Aura"
            android:textColor="@color/cyber_teal"
            android:textSize="12sp" />

        <ImageButton
            android:id="@+id/btnRemoveAttachedImage"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_delete"
            app:tint="@color/on_surface_variant_obsidian"
            android:contentDescription="Quitar imagen" />
    </LinearLayout>

    <!-- ===== Quick Skills Toolbar ===== -->
    <HorizontalScrollView
        android:id="@+id/scrollQuickSkills"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingVertical="4dp"
        android:overScrollMode="never">

        <LinearLayout
            android:id="@+id/laySkillsContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAllSkills"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:paddingHorizontal="12dp"
                android:textSize="12sp"
                android:text="⚡ Skills"
                app:backgroundTint="@color/cyber_teal"
                android:textColor="@color/obsidian_bg" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipCall"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="4dp"
                android:text="📞 Llamar"
                android:textColor="@color/on_surface_obsidian"
                app:chipBackgroundColor="@color/obsidian_container_low" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipWhatsapp"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="4dp"
                android:text="💬 WhatsApp"
                android:textColor="@color/on_surface_obsidian"
                app:chipBackgroundColor="@color/obsidian_container_low" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipEmail"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="4dp"
                android:text="✉️ Email"
                android:textColor="@color/on_surface_obsidian"
                app:chipBackgroundColor="@color/obsidian_container_low" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipTelegram"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="4dp"
                android:text="✈️ Telegram"
                android:textColor="@color/on_surface_obsidian"
                app:chipBackgroundColor="@color/obsidian_container_low" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipGoogle"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="4dp"
                android:text="🔍 Google"
                android:textColor="@color/on_surface_obsidian"
                app:chipBackgroundColor="@color/obsidian_container_low" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipWiki"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="4dp"
                android:text="📖 Wiki"
                android:textColor="@color/on_surface_obsidian"
                app:chipBackgroundColor="@color/obsidian_container_low" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipWeather"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="4dp"
                android:text="☀️ Clima"
                android:textColor="@color/on_surface_obsidian"
                app:chipBackgroundColor="@color/obsidian_container_low" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipCurrency"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="4dp"
                android:text="💵 Divisas"
                android:textColor="@color/on_surface_obsidian"
                app:chipBackgroundColor="@color/obsidian_container_low" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipNote"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="4dp"
                android:text="📝 Nota"
                android:textColor="@color/on_surface_obsidian"
                app:chipBackgroundColor="@color/obsidian_container_low" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipReminder"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="4dp"
                android:text="⏰ Recordatorio"
                android:textColor="@color/on_surface_obsidian"
                app:chipBackgroundColor="@color/obsidian_container_low" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipRecorder"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="4dp"
                android:text="🎙️ Grabar IA"
                android:textColor="@color/on_surface_obsidian"
                app:chipBackgroundColor="@color/obsidian_container_low" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- ===== Input Control Bar (bottomBar for EdgeToEdgeHelper) ===== -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="4dp"
        android:paddingBottom="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAttachImage"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:icon="@android:drawable/ic_menu_camera"
            app:iconTint="@color/cyber_teal"
            android:contentDescription="Adjuntar Imagen" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVoiceMic"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:icon="@drawable/ic_mic"
            app:iconTint="@color/cyber_teal"
            android:contentDescription="Voz STT" />

        <EditText
            android:id="@+id/edtChatMessage"
            style="@style/Input.Myvu"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="4dp"
            android:hint="Pregunta a Aura o usa un skill..."
            android:inputType="textCapSentences|textMultiLine"
            android:imeOptions="actionSend"
            android:maxLines="4" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSendChat"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            app:icon="@android:drawable/ic_menu_send"
            app:iconTint="@color/on_cyber_teal"
            app:backgroundTint="@color/cyber_teal"
            android:contentDescription="Enviar" />
    </LinearLayout>
</LinearLayout>
