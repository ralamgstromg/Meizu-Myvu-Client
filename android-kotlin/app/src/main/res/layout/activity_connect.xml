<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/obsidian_bg">

    <!-- Main screen layout container -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- ===== Top bar ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp"
                android:paddingTop="20dp"
                android:paddingBottom="12dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnNavigationDrawer"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="12dp"
                    android:contentDescription="Navigation Drawer"
                    app:icon="@drawable/ic_menu_hamburger"
                    app:iconTint="@color/on_surface_obsidian" />

                <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MYVU"
                    android:textColor="@color/cyber_teal"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AR GLASSES CLIENT"
                    android:fontFamily="monospace"
                    android:textSize="11sp"
                    android:letterSpacing="0.1"
                    android:textColor="@color/on_surface_variant_obsidian" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSettings"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="Settings"
                app:icon="@drawable/ic_settings"
                app:iconTint="@color/on_surface_obsidian" />
        </LinearLayout>

        <!-- ===== Navigation Tabs ===== -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabs"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@color/obsidian_bg"
            app:tabMode="fixed"
            app:tabGravity="fill"
            app:tabIndicatorColor="@color/cyber_teal"
            app:tabIndicatorHeight="3dp"
            app:tabSelectedTextColor="@color/cyber_teal"
            app:tabTextColor="@color/on_surface_variant_obsidian"
            app:tabRippleColor="#2000F0FF">

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Controls" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Log" />
        </com.google.android.material.tabs.TabLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- ============================ CONTROLS PAGE ============================ -->
            <androidx.core.widget.NestedScrollView
                android:id="@+id/pageControls"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">

                <LinearLayout
                    android:id="@+id/content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="32dp">

                    <!-- Dashboard Landing View -->
                    <include layout="@layout/view_dashboard" />

                    <!-- Notifications -->
                    <com.google.android.material.card.MaterialCardView
                        style="@style/Card.Myvu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                style="@style/CardTitle.Myvu"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Notifications" />

                            <com.google.android.material.textfield.TextInputLayout
                                style="@style/Input.Myvu"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:hint="Title (optional)">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/txtNotifyTitle"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/on_surface_obsidian"
                                    android:maxLines="1"
                                    android:importantForAutofill="no" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.textfield.TextInputLayout
                                style="@style/Input.Myvu"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:hint="Message">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/txtNotifyBody"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/on_surface_obsidian"
                                    android:maxLines="3"
                                    android:importantForAutofill="no" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnNotify"
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:layout_marginTop="12dp"
                                app:cornerRadius="16dp"
                                app:backgroundTint="@color/obsidian_container_high"
                                android:textColor="@color/cyber_teal"
                                android:textStyle="bold"
                                android:text="Send to lens" />

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:layout_marginVertical="14dp"
                                android:background="@color/outline_variant_obsidian" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Mirror phone notifications"
                                        android:textColor="@color/on_surface_obsidian"
                                        android:textAppearance="?attr/textAppearanceBodyLarge" />

                                    <TextView
                                        style="@style/Label.Myvu"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Forward real SMS / chat to the lens" />
                                </LinearLayout>

                                <com.google.android.material.materialswitch.MaterialSwitch
                                    android:id="@+id/swMirror"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content" />
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- AI assistant -->
                    <com.google.android.material.card.MaterialCardView
                        style="@style/Card.Myvu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                style="@style/CardTitle.Myvu"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="AI assistant" />

                            <TextView
                                style="@style/Label.Myvu"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Press the glasses button and speak, or type below" />

                            <com.google.android.material.textfield.TextInputLayout
                                style="@style/Input.Myvu"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:hint="Ask a question">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/txtAsk"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/on_surface_obsidian"
                                    android:maxLines="2"
                                    android:importantForAutofill="no" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnAsk"
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:layout_marginTop="12dp"
                                app:cornerRadius="16dp"
                                app:backgroundTint="@color/cyber_teal"
                                android:textColor="@color/on_cyber_teal"
                                android:textStyle="bold"
                                android:text="Ask" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnAiSettings"
                                style="@style/Widget.Material3.Button.TextButton"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                app:icon="@drawable/ic_settings"
                                app:iconTint="@color/cyber_teal"
                                android:textColor="@color/cyber_teal"
                                android:text="API keys &amp; system prompt" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Teleprompter -->
                    <com.google.android.material.card.MaterialCardView
                        style="@style/Card.Myvu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                style="@style/CardTitle.Myvu"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Teleprompter" />

                            <com.google.android.material.textfield.TextInputLayout
                                style="@style/Input.Myvu"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:hint="Script text">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/txtTici"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:minLines="2"
                                    android:maxLines="5"
                                    android:gravity="top"
                                    android:textColor="@color/on_surface_obsidian"
                                    android:importantForAutofill="no" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnTici"
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:layout_marginTop="12dp"
                                app:cornerRadius="16dp"
                                app:backgroundTint="@color/obsidian_container_high"
                                android:textColor="@color/cyber_teal"
                                android:textStyle="bold"
                                android:text="Open on glasses" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- System -->
                    <com.google.android.material.card.MaterialCardView
                        style="@style/Card.Myvu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                style="@style/CardTitle.Myvu"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="System" />

                            <LinearLayout
                                android:id="@+id/rowWifi"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:layout_marginTop="12dp">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_weight="1"
                                    android:layout_height="wrap_content"
                                    android:text="Wi-Fi"
                                    android:textColor="@color/on_surface_obsidian"
                                    android:textAppearance="?attr/textAppearanceBodyLarge" />

                                <com.google.android.material.materialswitch.MaterialSwitch
                                    android:id="@+id/swWifi"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:layout_marginTop="8dp">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_weight="1"
                                    android:layout_height="wrap_content"
                                    android:text="Do not disturb (Zen)"
                                    android:textColor="@color/on_surface_obsidian"
                                    android:textAppearance="?attr/textAppearanceBodyLarge" />

                                <com.google.android.material.materialswitch.MaterialSwitch
                                    android:id="@+id/swZen"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:layout_marginTop="8dp">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_weight="1"
                                    android:layout_height="wrap_content"
                                    android:text="Wear detection"
                                    android:textColor="@color/on_surface_obsidian"
                                    android:textAppearance="?attr/textAppearanceBodyLarge" />

                                <com.google.android.material.materialswitch.MaterialSwitch
                                    android:id="@+id/swWear"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:layout_marginTop="8dp">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_weight="1"
                                    android:layout_height="wrap_content"
                                    android:text="Music touch-panel"
                                    android:textColor="@color/on_surface_obsidian"
                                    android:textAppearance="?attr/textAppearanceBodyLarge" />

                                <com.google.android.material.materialswitch.MaterialSwitch
                                    android:id="@+id/swMusicTp"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:layout_marginTop="8dp">

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_weight="1"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Air mode"
                                        android:textColor="@color/on_surface_obsidian"
                                        android:textAppearance="?attr/textAppearanceBodyLarge" />

                                    <TextView
                                        style="@style/Label.Myvu"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Closes all apps" />
                                </LinearLayout>

                                <com.google.android.material.materialswitch.MaterialSwitch
                                    android:id="@+id/swAir"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content" />
                            </LinearLayout>

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:layout_marginVertical="12dp"
                                android:background="@color/outline_variant_obsidian" />

                            <TextView
                                android:id="@+id/lblMainStandbyPos"
                                style="@style/Label.Myvu"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Posición del Dashboard en Gafas (FOV): Centro (0)" />

                            <com.google.android.material.slider.Slider
                                android:id="@+id/sliderMainStandbyPos"
                                style="@style/Slider.Myvu"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:valueFrom="0"
                                android:valueTo="3"
                                android:stepSize="1"
                                android:value="0" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_marginTop="8dp">

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnSyncTime"
                                    style="@style/Widget.Material3.Button.OutlinedButton"
                                    android:layout_width="0dp"
                                    android:layout_weight="1"
                                    android:layout_height="48dp"
                                    android:layout_marginEnd="6dp"
                                    app:cornerRadius="16dp"
                                    app:strokeColor="@color/outline_variant_obsidian"
                                    android:textColor="@color/on_surface_obsidian"
                                    android:text="Sync time" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnDeviceInfo"
                                    style="@style/Widget.Material3.Button.OutlinedButton"
                                    android:layout_width="0dp"
                                    android:layout_weight="1"
                                    android:layout_height="48dp"
                                    android:layout_marginStart="6dp"
                                    app:cornerRadius="16dp"
                                    app:strokeColor="@color/outline_variant_obsidian"
                                    android:textColor="@color/on_surface_obsidian"
                                    android:text="Device info" />
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Navigation -->
                    <com.google.android.material.card.MaterialCardView
                        style="@style/Card.Myvu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                style="@style/CardTitle.Myvu"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Navigation" />

                            <com.google.android.material.textfield.TextInputLayout
                                style="@style/Input.Myvu"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:hint="Destination (place or lat,lon)">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/txtDest"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/on_surface_obsidian"
                                    android:maxLines="1"
                                    android:importantForAutofill="no" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_marginTop="12dp">

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnNavStart"
                                    android:layout_width="0dp"
                                    android:layout_weight="1"
                                    android:layout_height="48dp"
                                    android:layout_marginEnd="6dp"
                                    app:cornerRadius="16dp"
                                    app:backgroundTint="@color/cyber_teal"
                                    android:textColor="@color/on_cyber_teal"
                                    android:textStyle="bold"
                                    android:text="Start" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnNavStop"
                                    style="@style/Widget.Material3.Button.OutlinedButton"
                                    android:layout_width="0dp"
                                    android:layout_weight="1"
                                    android:layout_height="48dp"
                                    android:layout_marginStart="6dp"
                                    app:cornerRadius="16dp"
                                    app:strokeColor="@color/outline_variant_obsidian"
                                    android:textColor="@color/on_surface_obsidian"
                                    android:text="Stop" />
                            </LinearLayout>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnIcNext"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:layout_marginTop="8dp"
                                app:cornerRadius="16dp"
                                app:strokeColor="@color/outline_variant_obsidian"
                                android:textColor="@color/on_surface_obsidian"
                                android:text="Calibrate turn icon" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>

            <!-- ============================ LOG PAGE ============================ -->
            <LinearLayout
                android:id="@+id/pageLog"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="16dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/CardTitle.Myvu"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Activity log" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnShareLog"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/cyber_teal"
                        android:text="Share" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnClearLog"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/cyber_teal"
                        android:text="Clear" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvLog"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="8dp"
                    android:background="@color/obsidian_container_low"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp"
                    android:clipToPadding="false"
                    android:scrollbars="vertical" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- ============================ PAIRING OVERLAY ============================ -->
    <FrameLayout
        android:id="@+id/pairingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/obsidian_bg"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp">

            <FrameLayout
                android:layout_width="240dp"
                android:layout_height="240dp"
                android:layout_marginBottom="40dp">

                <View
                    android:id="@+id/ring3"
                    android:layout_width="220dp"
                    android:layout_height="220dp"
                    android:layout_gravity="center"
                    android:background="@drawable/scan_ring" />

                <View
                    android:id="@+id/ring2"
                    android:layout_width="220dp"
                    android:layout_height="220dp"
                    android:layout_gravity="center"
                    android:background="@drawable/scan_ring" />

                <View
                    android:id="@+id/ring1"
                    android:layout_width="220dp"
                    android:layout_height="220dp"
                    android:layout_gravity="center"
                    android:background="@drawable/scan_ring" />

                <ImageView
                    android:id="@+id/imgGlasses"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_glasses"
                    app:tint="@color/cyber_teal"
                    android:contentDescription="glasses" />

                <ImageView
                    android:id="@+id/imgCheck"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_gravity="center|bottom"
                    android:src="@drawable/ic_check_circle"
                    app:tint="@color/cyber_teal"
                    android:visibility="gone"
                    android:contentDescription="connected" />
            </FrameLayout>

            <TextView
                android:id="@+id/pairTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Searching for your glasses"
                android:textAppearance="?attr/textAppearanceHeadlineSmall"
                android:textColor="@color/on_surface_obsidian"
                android:textStyle="bold"
                android:gravity="center" />

            <TextView
                android:id="@+id/pairSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="@color/on_surface_variant_obsidian"
                android:text="Make sure they are powered on and nearby" />

            <LinearLayout
                android:id="@+id/pairButtons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="36dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:visibility="gone">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPairCancel"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="48dp"
                    android:layout_marginEnd="6dp"
                    app:cornerRadius="16dp"
                    app:strokeColor="@color/outline_variant_obsidian"
                    android:textColor="@color/on_surface_obsidian"
                    android:text="Cancel" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPairRetry"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="48dp"
                    android:layout_marginStart="6dp"
                    app:cornerRadius="16dp"
                    app:backgroundTint="@color/cyber_teal"
                    android:textColor="@color/on_cyber_teal"
                    android:textStyle="bold"
                    android:text="Try again" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPairDone"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="36dp"
                app:cornerRadius="16dp"
                app:backgroundTint="@color/cyber_teal"
                android:textColor="@color/on_cyber_teal"
                android:textStyle="bold"
                android:text="Done"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>
    </FrameLayout>

    <!-- Navigation View (Drawer) -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/obsidian_container_low"
        app:headerLayout="@layout/nav_header_drawer"
        app:menu="@menu/menu_navigation_drawer"
        app:itemIconTint="@color/cyber_teal"
        app:itemTextColor="@color/on_surface_obsidian"
        app:itemShapeInsetStart="12dp"
        app:itemShapeInsetEnd="12dp" />

</androidx.drawerlayout.widget.DrawerLayout>
