<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/obsidian_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top App Bar -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbarVoiceRecorder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/obsidian_bg"
            app:navigationIcon="@android:drawable/ic_menu_revert"
            app:navigationIconTint="@color/cyber_teal"
            app:title="Grabadora de Voz IA"
            app:titleTextColor="@color/on_surface_obsidian"
            app:subtitle="Reuniones, Ideas y Conversaciones"
            app:subtitleTextColor="@color/on_surface_variant_obsidian">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnQuickAiAction"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="end"
                android:layout_marginEnd="12dp"
                android:contentDescription="AI Action"
                app:icon="@drawable/ic_sparkle"
                app:iconTint="@color/cyber_teal" />
        </com.google.android.material.appbar.MaterialToolbar>

        <!-- Search Bar -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"
            app:cardBackgroundColor="@color/obsidian_container_low"
            app:cardCornerRadius="12dp"
            app:strokeColor="@color/outline_variant_obsidian"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="Search"
                    android:src="@drawable/ic_search"
                    app:tint="@color/cyber_teal" />

                <EditText
                    android:id="@+id/etSearchRecordings"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:hint="Buscar por nombre, texto o tag..."
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:textColor="@color/on_surface_obsidian"
                    android:textColorHint="@color/outline_obsidian"
                    android:textSize="14sp" />

                <ImageView
                    android:id="@+id/btnClearSearch"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="Clear"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    android:visibility="gone"
                    app:tint="@color/outline_obsidian" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Categories Filter Chips -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupCategories"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipCatAll"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Todas"
                    android:textColor="@color/on_surface_obsidian"
                    app:chipBackgroundColor="@color/obsidian_container_high" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipCatMeeting"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="👥 Reuniones"
                    android:textColor="@color/on_surface_obsidian"
                    app:chipBackgroundColor="@color/obsidian_container_high" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipCatIdea"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💡 Ideas"
                    android:textColor="@color/on_surface_obsidian"
                    app:chipBackgroundColor="@color/obsidian_container_high" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipCatConversation"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🗣️ Conversaciones"
                    android:textColor="@color/on_surface_obsidian"
                    app:chipBackgroundColor="@color/obsidian_container_high" />
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <!-- Dynamic Tags Filter Chips -->
        <HorizontalScrollView
            android:id="@+id/scrollTags"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:paddingHorizontal="16dp"
            android:scrollbars="none"
            android:visibility="gone">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupTags"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleSelection="true" />
        </HorizontalScrollView>

        <!-- Main Content Area -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- RecyclerView of Recordings -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvVoiceRecordings"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingHorizontal="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="90dp" />

            <!-- Empty State -->
            <LinearLayout
                android:id="@+id/layEmptyRecordings"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="32dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:contentDescription="Empty"
                    android:src="@drawable/ic_mic"
                    app:tint="@color/outline_variant_obsidian" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Sin grabaciones de voz"
                    android:textColor="@color/on_surface_obsidian"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="Toca el botón rojo de abajo para grabar una reunión, conversación o lluvia de ideas. La IA la transcribirá, resumirá y extraerá tareas."
                    android:textColor="@color/on_surface_variant_obsidian"
                    android:textSize="14sp" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- FAB for New Recording -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabStartRecording"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="24dp"
        android:backgroundTint="#FF3B30"
        android:contentDescription="Grabar Reunión o Idea"
        android:text="Grabar con IA"
        android:textColor="@android:color/white"
        android:textStyle="bold"
        app:icon="@drawable/ic_mic"
        app:iconTint="@android:color/white" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
