<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:orientation="vertical">

    <!-- Speaker Header -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvSpeakerName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chip_badge"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:text="👤 Hablante 1"
            android:textColor="@color/cyber_teal"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSpeakerTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="00:15"
            android:textColor="@color/outline_obsidian"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Speech Content Bubble -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:cardBackgroundColor="@color/obsidian_container_low"
        app:cardCornerRadius="12dp"
        app:strokeColor="@color/outline_variant_obsidian"
        app:strokeWidth="1dp">

        <TextView
            android:id="@+id/tvSpeakerText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:text="Texto pronunciado por el hablante en este punto..."
            android:textColor="@color/on_surface_obsidian"
            android:textSize="14sp" />
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
