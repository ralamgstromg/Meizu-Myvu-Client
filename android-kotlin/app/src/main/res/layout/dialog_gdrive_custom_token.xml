<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        style="@style/Label.Myvu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ingresa un Access Token o las credenciales de tu proyecto de Google Cloud Console para sincronizar /myvu/backup/data.zip:"
        android:textSize="12sp" />

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Input.Myvu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="Correo de Google (Opcional)">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/txtCustomEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textEmailAddress"
            android:maxLines="1"
            android:textColor="@color/on_surface_obsidian" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Input.Myvu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="Google Drive Access Token (OAuth)">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/txtCustomToken"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPassword"
            android:textColor="@color/on_surface_obsidian"
            app:passwordToggleEnabled="true" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        style="@style/Label.Myvu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Opcional: Cliente OAuth Personal (Google Cloud):"
        android:textSize="11sp"
        android:textStyle="bold" />

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Input.Myvu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:hint="OAuth Client ID">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/txtCustomClientId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="@color/on_surface_obsidian" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Input.Myvu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:hint="OAuth Client Secret (si aplica)">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/txtCustomClientSecret"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPassword"
            android:maxLines="1"
            android:textColor="@color/on_surface_obsidian"
            app:passwordToggleEnabled="true" />
    </com.google.android.material.textfield.TextInputLayout>

</LinearLayout>
