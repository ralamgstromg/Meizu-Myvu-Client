<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- ==================== CENTRAL HERO CONNECTION CARD ==================== -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardStatus"
        style="@style/Card.Myvu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/obsidian_container_low"
        app:cardCornerRadius="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/statusDot"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/status_dot" />

                <TextView
                    android:id="@+id/txtStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Disconnected"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="@color/on_surface_obsidian"
                    android:textStyle="bold" />

                <ProgressBar
                    android:id="@+id/progress"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:indeterminateTint="@color/cyber_teal"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtGlasses"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginStart="26dp"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/on_surface_variant_obsidian"
                android:visibility="gone" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Input.Myvu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:helperTextEnabled="true"
                app:helperText="Leave blank to auto-search"
                app:helperTextTextColor="@color/on_surface_variant_obsidian"
                android:hint="Glasses MAC address">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/txtMac"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapCharacters"
                    android:importantForAutofill="no"
                    android:textColor="@color/on_surface_obsidian"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnConnect"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    app:cornerRadius="16dp"
                    app:backgroundTint="@color/cyber_teal"
                    android:textColor="@color/on_cyber_teal"
                    android:textStyle="bold"
                    android:text="Connect" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDisconnect"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    app:cornerRadius="16dp"
                    app:backgroundTint="@color/obsidian_container_high"
                    android:textColor="@color/cyber_teal"
                    android:textStyle="bold"
                    android:text="Disconnect" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTrackpad"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                app:cornerRadius="16dp"
                app:strokeColor="@color/outline_variant_obsidian"
                android:textColor="@color/on_surface_obsidian"
                app:icon="@drawable/ic_trackpad"
                app:iconTint="@color/cyber_teal"
                android:text="Open trackpad" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNotes"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                app:cornerRadius="16dp"
                app:strokeColor="@color/outline_variant_obsidian"
                android:textColor="@color/on_surface_obsidian"
                android:text="Notas y Recordatorios" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ==================== QUICK VOICE CONTROL BANNER ==================== -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnVoiceControl"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="12dp"
        app:cornerRadius="20dp"
        app:backgroundTint="@color/cyber_teal"
        android:textColor="@color/on_cyber_teal"
        android:textStyle="bold"
        android:textSize="15sp"
        android:letterSpacing="0.02"
        app:icon="@drawable/ic_mic"
        app:iconGravity="textStart"
        app:iconPadding="10dp"
        app:iconTint="@color/on_cyber_teal"
        android:text="Inicializar Control por Voz" />

    <!-- ==================== BENTO TELEMETRY STATS GRID ==================== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Row 1: Glasses Battery & Active AI Model -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Glasses Battery Card -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Card.Myvu"
                android:id="@+id/cardBatteryStat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                app:cardBackgroundColor="@color/obsidian_container_low"
                app:cardCornerRadius="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_battery"
                            app:tint="@color/cyber_teal"
                            android:contentDescription="battery" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="Batería Gafas"
                            android:textColor="@color/on_surface_variant_obsidian"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/txtBatteryStat"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="--"
                        android:textColor="@color/on_surface_obsidian"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Active AI Model Card -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Card.Myvu"
                android:id="@+id/btnAiSettings"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                app:cardBackgroundColor="@color/obsidian_container_low"
                app:cardCornerRadius="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_sparkle"
                            app:tint="@color/cyber_teal"
                            android:contentDescription="ai model" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="Modelo IA"
                            android:textColor="@color/on_surface_variant_obsidian"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/txtAiModelStat"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="OpenAI / GPT-4o"
                        android:textColor="@color/cyber_teal"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </LinearLayout>

    <!-- ==================== RECENT NOTES CARD ==================== -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardRecentNotes"
        style="@style/Card.Myvu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/obsidian_container_low"
        app:cardCornerRadius="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/ic_note"
                    app:tint="@color/cyber_teal"
                    android:contentDescription="notes" />

                <TextView
                    style="@style/CardTitle.Myvu"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Notas Recientes" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOpenAllNotes"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/cyber_teal"
                    android:textSize="12sp"
                    android:text="Ver todas" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutRecentNotesContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_obsidian_card"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/txtRecentNote1Title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Nota de voz 1"
                        android:textColor="@color/on_surface_obsidian"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtRecentNote1Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:maxLines="2"
                        android:text="Sin contenido reciente"
                        android:textColor="@color/on_surface_variant_obsidian"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_obsidian_card"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/txtRecentNote2Title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Nota de voz 2"
                        android:textColor="@color/on_surface_obsidian"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtRecentNote2Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:maxLines="2"
                        android:text="Sin contenido reciente"
                        android:textColor="@color/on_surface_variant_obsidian"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ==================== UPCOMING REMINDERS CARD ==================== -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardUpcomingReminders"
        style="@style/Card.Myvu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/obsidian_container_low"
        app:cardCornerRadius="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/ic_bell"
                    app:tint="@color/cyber_teal"
                    android:contentDescription="reminders" />

                <TextView
                    style="@style/CardTitle.Myvu"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Próximamente" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutUpcomingRemindersContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_obsidian_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/txtReminder1Title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Sin recordatorios pendientes"
                        android:textColor="@color/on_surface_obsidian"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtReminder1Time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--:--"
                        android:textColor="@color/cyber_teal"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_obsidian_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/txtReminder2Title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="--"
                        android:textColor="@color/on_surface_obsidian"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtReminder2Time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--:--"
                        android:textColor="@color/cyber_teal"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
