<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ios_system_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top Bar estilo iOS -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbarNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:background="@color/ios_system_bg"
            app:navigationIcon="@drawable/ic_menu_hamburger"
            app:navigationIconTint="@color/ios_blue"
            app:title="Notas y Recordatorios"
            app:titleTextColor="@color/ios_label">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingEnd="12dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnNotesDrawer"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:contentDescription="Navigation Menu"
                    app:icon="@drawable/ic_menu_hamburger"
                    app:iconTint="@color/ios_blue" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnNotesDevices"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:contentDescription="Dispositivos Bluetooth"
                    app:icon="@drawable/ic_bluetooth_device"
                    app:iconTint="@color/ios_blue" />

                <LinearLayout
                    android:id="@+id/layNotesGlassesBattery"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_ios_pill"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:contentDescription="Glasses Battery Status"
                        android:src="@drawable/ic_battery"
                        app:tint="@color/ios_green" />

                    <TextView
                        android:id="@+id/txtNotesGlassesBattery"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="--"
                        android:textColor="@color/ios_label"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.appbar.MaterialToolbar>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="@color/ios_separator" />

        <!-- Search Bar -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutSearchNotes"
            style="@style/Input.Myvu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:hint="Buscar por título, contenido o #tags..."
            app:boxCornerRadiusBottomEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp"
            app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusTopStart="14dp"
            app:startIconDrawable="@drawable/ic_search"
            app:startIconTint="@color/ios_secondary_label">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/txtSearchNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="@color/ios_label" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Filter Chips -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingBottom="8dp"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupFilter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleLine="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipFilterAll"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Todos"
                    android:textSize="12sp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipFilterText"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Texto"
                    android:textSize="12sp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipFilterVoice"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Voz"
                    android:textSize="12sp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipFilterReminders"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Recordatorios"
                    android:textSize="12sp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipFilterPending"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pendientes"
                    android:textSize="12sp" />

            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <!-- Tabs estilo iOS Segmented Control -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabsNotes"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@color/ios_system_bg"
            app:tabGravity="fill"
            app:tabIndicatorColor="@color/ios_blue"
            app:tabIndicatorHeight="2.5dp"
            app:tabMode="fixed"
            app:tabRippleColor="#1A007AFF"
            app:tabSelectedTextColor="@color/ios_blue"
            app:tabTextColor="@color/ios_secondary_label">

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Notas" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Recordatorios" />
        </com.google.android.material.tabs.TabLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="@color/ios_separator" />

        <!-- Content Container -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- Page 1: Notes -->
            <LinearLayout
                android:id="@+id/pageNotes"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Input.Myvu"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="Escribe una nueva nota...">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/txtNewNote"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:importantForAutofill="no"
                            android:maxLines="3"
                            android:textColor="@color/ios_label" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAddNote"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginStart="8dp"
                        android:text="Guardar"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        app:backgroundTint="@color/ios_blue"
                        app:cornerRadius="14dp" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvNotes"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="12dp"
                    android:clipToPadding="false"
                    android:paddingBottom="80dp" />
            </LinearLayout>

            <!-- Page 2: Reminders -->
            <LinearLayout
                android:id="@+id/pageReminders"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="8dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Input.Myvu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Texto del recordatorio...">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/txtNewReminder"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:importantForAutofill="no"
                            android:maxLines="3"
                            android:textColor="@color/ios_label" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPickTime"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:text="Seleccionar Hora"
                            android:textColor="@color/ios_blue"
                            app:cornerRadius="14dp"
                            app:strokeColor="@color/ios_separator" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnAddReminder"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:layout_marginStart="8dp"
                            android:text="Programar"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"
                            app:backgroundTint="@color/ios_blue"
                            app:cornerRadius="14dp" />
                    </LinearLayout>
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvReminders"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="12dp"
                    android:clipToPadding="false"
                    android:paddingBottom="80dp" />
            </LinearLayout>

        </FrameLayout>
    </LinearLayout>

    <!-- Speed Dial FAB Cluster estilo Apple -->
    <LinearLayout
        android:id="@+id/fabCluster"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:gravity="end"
        android:orientation="vertical">

        <!-- Sub-button menu container -->
        <LinearLayout
            android:id="@+id/fabMenu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:gravity="end"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Sub-button 1: New Text Note -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/fabNewText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Nuevo Texto"
                android:textColor="@color/ios_label"
                app:backgroundTint="@color/ios_card_bg"
                app:cornerRadius="20dp"
                app:icon="@drawable/ic_note"
                app:iconTint="@color/ios_blue"
                app:strokeColor="@color/ios_separator"
                app:strokeWidth="1dp" />

            <!-- Sub-button 2: New Voice Note -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/fabNewVoice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Grabar Voz"
                android:textColor="@color/ios_label"
                app:backgroundTint="@color/ios_card_bg"
                app:cornerRadius="20dp"
                app:icon="@drawable/ic_mic"
                app:iconTint="@color/ios_blue"
                app:strokeColor="@color/ios_separator"
                app:strokeWidth="1dp" />

            <!-- Sub-button 3: New Reminder -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/fabNewReminder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Añadir Recordatorio"
                android:textColor="@color/ios_label"
                app:backgroundTint="@color/ios_card_bg"
                app:cornerRadius="20dp"
                app:icon="@drawable/ic_add_alarm"
                app:iconTint="@color/ios_blue"
                app:strokeColor="@color/ios_separator"
                app:strokeWidth="1dp" />

        </LinearLayout>

        <!-- Main FAB -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabMain"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="Menu acciones"
            app:backgroundTint="@color/ios_blue"
            app:srcCompat="@drawable/ic_add"
            app:tint="#FFFFFF" />

    </LinearLayout>

</FrameLayout>
