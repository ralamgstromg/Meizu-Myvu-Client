<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Myvu" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/cyber_teal</item>
        <item name="colorOnPrimary">@color/on_cyber_teal</item>
        <item name="colorPrimaryContainer">@color/obsidian_container</item>
        <item name="colorOnPrimaryContainer">@color/on_cyber_teal_container</item>

        <item name="android:colorBackground">@color/obsidian_bg</item>
        <item name="colorSurface">@color/obsidian_container_low</item>
        <item name="colorOnSurface">@color/on_surface_obsidian</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant_obsidian</item>
        <item name="colorOutline">@color/outline_variant_obsidian</item>

        <item name="android:statusBarColor">@color/obsidian_bg</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
    </style>

    <!-- Filled card used for every feature section. -->
    <style name="Card.Myvu" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">28dp</item>
        <item name="cardElevation">0dp</item>
        <item name="contentPadding">18dp</item>
        <item name="cardBackgroundColor">@color/obsidian_container_low</item>
        <item name="strokeColor">@color/outline_variant_obsidian</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:layout_marginBottom">12dp</item>
    </style>

    <style name="CardTitle.Myvu" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:textColor">@color/on_surface_obsidian</item>
    </style>

    <style name="Label.Myvu" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/on_surface_variant_obsidian</item>
    </style>

    <style name="Input.Myvu" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="boxBackgroundColor">@color/obsidian_container_high</item>
        <item name="boxStrokeColor">@color/input_box_stroke</item>
        <item name="hintTextColor">@color/cyber_teal</item>
        <item name="android:textColorHint">@color/on_surface_variant_obsidian</item>
    </style>

    <style name="Button.Myvu.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">16dp</item>
        <item name="strokeColor">@color/outline_variant_obsidian</item>
        <item name="android:textColor">@color/on_surface_obsidian</item>
        <item name="rippleColor">#3300F0FF</item>
    </style>

    <style name="Switch.Myvu" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="thumbTint">@color/switch_thumb_tint</item>
        <item name="trackTint">@color/switch_track_tint</item>
    </style>

    <style name="Slider.Myvu" parent="Widget.Material3.Slider">
        <item name="thumbColor">@color/cyber_teal</item>
        <item name="trackColorActive">@color/cyber_teal</item>
        <item name="trackColorInactive">@color/obsidian_container_highest</item>
        <item name="haloColor">#3300F0FF</item>
    </style>
</resources>
